# Copy to playground/.env for Docker Compose. Never commit .env.
# Non-secret application settings are in playground/config.yml.
# Use a published sha-... tag to pin a deployment to one build.
NOCOBASE_IMAGE=ghcr.io/nocobase/crm:latest

# Local access by default. Use 0.0.0.0 to expose the port on other interfaces.
NOCOBASE_BIND_HOST=127.0.0.1
NOCOBASE_PORT=13000

# The browser-facing origin, without /main. Use HTTPS for a remote deployment.
# Update this when changing the published port or using a reverse proxy.
APP_PUBLIC_ORIGIN=http://localhost:13000

# Run `openssl rand -hex 32` twice and paste one result into each value.
# Keep these values unchanged across restarts and image updates.
AUTH_SECRET=
SESSION_SECRET=

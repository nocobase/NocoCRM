node_modules/
dist/
coverage/
.DS_Store

# Local configuration, including the generated AUTH_SECRET.
/config.yml

# Local environment secrets.
.env
.env.*
!.env.example

# Local application state.
/storage/*
/.agents/
/.agent-annotations/
/.nocobase/
*.log

# Personal editor/agent settings.
/.claude/settings.local.json

# SQLite databases anywhere (the application state lives under storage/).
*.sqlite
*.sqlite-journal

# pnpm's local content store.
/.pnpm-store

# Generated mirror of .agents/skills for Claude Code (skills:sync).
/.claude/skills/

# Written by `pnpm nocobase db apply` and `pnpm dev` after migrating; derived, never read back.
database/*/collections/
